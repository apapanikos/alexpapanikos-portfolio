# Absolute URL of the deployed site, with no trailing slash.
#
# Optional. On Vercel you can leave this unset: the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which is your custom domain once one is
# attached and the .vercel.app domain before that.
#
# Set it only to pin the URL explicitly — for example when deploying somewhere
# other than Vercel, or when you want canonical tags on a domain that isn't the
# shortest one attached to the project.
# PUBLIC_SITE_URL="https://alexpapanikos.dev"
