---
interface Props {
  href: string;
  variant?: 'solid' | 'outline';
  class?: string;
  external?: boolean;
}

const {
  href,
  variant = 'solid',
  class: className = '',
  external = false,
}: Props = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2.5 rounded-md px-5 py-3 text-sm font-medium transition-colors duration-200 ease-out';

const variants = {
  solid: 'bg-accent text-accent-fg hover:bg-accent-hover',
  outline:
    'border border-border-strong text-fg hover:border-accent hover:bg-accent-soft hover:text-accent',
} as const;
---

<a
  href={href}
  class:list={[base, variants[variant], className]}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <slot />
  <svg
    class="size-3.5 transition-transform duration-200 ease-out group-hover:translate-x-0.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M5 12h14M13 6l6 6-6 6"></path>
  </svg>
</a>
