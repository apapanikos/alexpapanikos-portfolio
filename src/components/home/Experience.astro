---
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';
import SectionGrid from '../SectionGrid.astro';
import { EXPERIENCE } from '../../consts';
---

<section
  id="experience"
  class="relative scroll-mt-24 border-t border-border py-20 sm:py-28"
>
  <SectionGrid marks="top" />

  <Container class="relative">
    <div class="max-w-2xl">
      <Eyebrow data-reveal>Track record</Eyebrow>
      <h2 data-reveal style="--reveal-delay: 60ms" class="mt-5 text-title font-semibold">
        Where I've been.
      </h2>
    </div>

    <ol class="mt-14 border-t border-border">
      {
        EXPERIENCE.map((job, index) => (
          <li
            data-reveal
            style={`--reveal-delay: ${index * 70}ms`}
            class="grid gap-x-10 gap-y-3 border-b border-border py-8 sm:grid-cols-[9rem_1fr] sm:py-10"
          >
            <p class="font-mono text-label text-subtle tabular sm:pt-1.5">{job.period}</p>
            <div>
              <h3 class="text-lg font-semibold tracking-tight">
                {job.role}
                <span class="mx-2 font-normal text-border-strong" aria-hidden="true">
                  /
                </span>
                <span class="font-normal text-muted">{job.org}</span>
              </h3>
              <p class="mt-3 max-w-2xl leading-relaxed text-muted">{job.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
