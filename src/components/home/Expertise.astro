---
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';
import SectionGrid from '../SectionGrid.astro';
import Chip from '../Chip.astro';
import { EXPERTISE } from '../../consts';
---

<section
  id="expertise"
  class="relative scroll-mt-24 border-t border-border py-20 sm:py-28"
>
  <SectionGrid marks="top" />

  <Container class="relative">
    <div class="max-w-2xl">
      <Eyebrow data-reveal>Expertise</Eyebrow>
      <h2 data-reveal style="--reveal-delay: 60ms" class="mt-5 text-title font-semibold">
        What I'm actually good at.
      </h2>
      <p data-reveal style="--reveal-delay: 120ms" class="mt-5 text-lg text-muted">
        Two tiers, and not equal ones. Worth being clear about which is which before you
        hire anyone.
      </p>
    </div>

    {/*
      A divider rather than cards: Services below already uses the bordered-cell
      treatment, and repeating it here would flatten the two sections together.
    */}
    <div class="mt-14 grid gap-x-14 gap-y-12 sm:grid-cols-2 sm:divide-x sm:divide-border">
      {
        EXPERTISE.map((group, index) => (
          <div
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
            class:list={[index === 1 && 'sm:pl-14']}
          >
            <p class="font-mono text-label text-accent uppercase">{group.tier}</p>
            <h3 class="mt-4 text-xl font-semibold tracking-tight">{group.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{group.summary}</p>
            <ul class="mt-6 flex flex-wrap gap-1.5">
              {group.skills.map((skill) => (
                <Chip as="li">{skill}</Chip>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Container>
</section>
