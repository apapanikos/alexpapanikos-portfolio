---
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';
import SectionGrid from '../SectionGrid.astro';
import Chip from '../Chip.astro';
import { EXPERTISE, EXPERTISE_INTRO } from '../../consts';
---

<section
  id="expertise"
  class="relative scroll-mt-24 border-t border-border py-20 sm:py-28"
>
  <SectionGrid marks="top" />

  <Container class="relative">
    <div class="max-w-2xl">
      <Eyebrow data-reveal>Expertise</Eyebrow>
      <h2 data-reveal style="--reveal-delay: 60ms" class="mt-5 text-title font-semibold">
        What I'm actually good at.
      </h2>
      <p data-reveal style="--reveal-delay: 120ms" class="mt-5 text-lg text-muted">
        {EXPERTISE_INTRO}
      </p>
    </div>

    {/*
      Ranked rows rather than columns. Reading order carries the hierarchy, and
      only the primary tier gets the accent label — three equal columns would
      imply three equal strengths, which is the opposite of the point.
      Mirrors the row treatment used by the Experience section below.
    */}
    <ol class="mt-14 border-t border-border">
      {
        EXPERTISE.map((group, index) => (
          <li
            data-reveal
            style={`--reveal-delay: ${index * 80}ms`}
            class="grid gap-x-14 gap-y-4 border-b border-border py-9 lg:grid-cols-[14rem_1fr] lg:py-10"
          >
            <div>
              <p
                class:list={[
                  'font-mono text-label uppercase',
                  index === 0 ? 'text-accent' : 'text-subtle',
                ]}
              >
                {group.tier}
              </p>
              <h3 class="mt-3 text-xl font-semibold tracking-tight">{group.title}</h3>
            </div>

            <div>
              <p class="max-w-3xl leading-relaxed text-muted">{group.summary}</p>
              <ul class="mt-6 flex flex-wrap gap-1.5">
                {group.skills.map((skill) => (
                  <Chip as="li">{skill}</Chip>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
