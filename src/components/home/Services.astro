---
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';
import SectionGrid from '../SectionGrid.astro';
import Chip from '../Chip.astro';
import { SERVICES } from '../../consts';
---

<section
  id="services"
  class="relative scroll-mt-24 border-t border-border py-20 sm:py-28"
>
  <SectionGrid marks="top" />

  <Container class="relative">
    <div class="max-w-2xl">
      <Eyebrow data-reveal>What I do</Eyebrow>
      <h2 data-reveal style="--reveal-delay: 60ms" class="mt-5 text-title font-semibold">
        What I take on.
      </h2>
      <p data-reveal style="--reveal-delay: 120ms" class="mt-5 text-lg text-muted">
        I work part-time and freelance, mostly with founders and small product teams.
        Fixed scope when the work is clear, retainer when it isn't.
      </p>
    </div>

    <ul class="mt-14 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2">
      {
        SERVICES.map((service, index) => (
          <li
            data-reveal
            style={`--reveal-delay: ${index * 70}ms`}
            class="group relative bg-bg p-7 transition-colors duration-300 hover:bg-surface sm:p-9"
          >
            <span
              aria-hidden="true"
              class="font-mono text-label text-subtle transition-colors duration-300 group-hover:text-accent"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-xl font-semibold tracking-tight">{service.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{service.description}</p>
            <ul class="mt-6 flex flex-wrap gap-1.5">
              {service.points.map((point) => (
                <Chip
                  as="li"
                  class="transition-colors duration-300 group-hover:border-border-strong"
                >
                  {point}
                </Chip>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
