---
import Container from './Container.astro';
import SectionGrid from './SectionGrid.astro';
import { LINKS, SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="relative border-t border-border">
  <SectionGrid marks="none" />

  <Container
    class="relative flex flex-col gap-8 py-12 sm:flex-row sm:items-end sm:justify-between"
  >
    <div class="space-y-1.5">
      <p class="text-sm font-medium">{SITE.name}</p>
      <p class="text-sm text-muted">
        {SITE.jobTitle} · {SITE.location}
      </p>
      <p class="text-sm">
        <a
          href={`mailto:${SITE.email}`}
          class="rounded-sm text-muted underline decoration-border-strong underline-offset-4 transition-colors duration-200 hover:text-accent hover:decoration-accent"
        >
          {SITE.email}
        </a>
      </p>
    </div>

    <div class="flex flex-col gap-4 sm:items-end">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                rel="me noopener noreferrer"
                target="_blank"
                class="rounded-sm text-sm text-muted transition-colors duration-200 hover:text-fg"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="font-mono text-label text-subtle tabular">
        © {year} {SITE.name} — built with Astro
      </p>
    </div>
  </Container>
</footer>
